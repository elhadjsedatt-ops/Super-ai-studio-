        showToast("حدث خطأ أثناء التوليد. تم تطبيق العرض التجريبي.", "error");
        // Fallback display
        document.getElementById('imgResultDisplay').src = "https://placehold.co/800x600/1e293b/ffffff?text=SuperAI+Generated+Art";
        document.getElementById('imgResultBox').classList.remove('hidden');
