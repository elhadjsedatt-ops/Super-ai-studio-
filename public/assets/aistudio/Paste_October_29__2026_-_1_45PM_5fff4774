      document.getElementById('vidLoading').classList.remove('hidden');

      // Generate keyframe using Flash Image, then animate on Canvas
      try {
        const apiKey = "";
        const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3.1-flash-image:generateContent?key=${apiKey}`;

        const res = await fetch(apiUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            contents: [{ role: 'user', parts: [{ text: `Cinematic movie scene frame for: ${prompt}` }] }],
            generationConfig: { responseModalities: ['IMAGE'], imageConfig: { aspectRatio: '16:9' } }
          })
        });

        const data = await res.json();
        const base64 = data?.candidates?.[0]?.content?.parts?.find(p => p.inlineData)?.inlineData?.data;

        const img = new Image();
        img.src = base64 ? `data:image/png;base64,${base64}` : "https://placehold.co/800x450/0f172a/ffffff?text=SuperAI+Video+Frame";
        await img.decode();

        renderAnimatedCanvas('videoCanvas', img);
        document.getElementById('vidResultBox').classList.remove('hidden');
        showToast("تم توليد مقطع الفيديو ورندرة الحركة!", "success");
      } catch (err) {
        showToast("خطأ في الاتصال، جاري استخدام محاكاة الحركة...", "error");
      } finally {
        document.getElementById('vidLoading').classList.add('hidden');
      }
    }

    function renderAnimatedCanvas(canvasId, srcImg) {
      const canvas = document.getElementById(canvasId);
      const ctx = canvas.getContext('2d');
      canvas.width = 640;
      canvas.height = 360;

      let frame = 0;
      if (videoAnimId) cancelAnimationFrame(videoAnimId);

      function loop() {
        frame++;
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        const scale = 1.0 + Math.sin(frame * 0.015) * 0.08;
        const dx = Math.cos(frame * 0.02) * 8;

        ctx.save();
        ctx.translate(canvas.width / 2 + dx, canvas.height / 2);
        ctx.scale(scale, scale);
        ctx.drawImage(srcImg, -canvas.width / 2, -canvas.height / 2, canvas.width, canvas.height);
        ctx.restore();

        // Particles Effect Overlay
        ctx.fillStyle = "rgba(255, 255, 255, 0.2)";
        for (let i = 0; i < 8; i++) {
          const px = (Math.sin(frame * 0.02 + i) * 0.5 + 0.5) * canvas.width;
          const py = (frame * (i + 1) * 0.8) % canvas.height;
          ctx.beginPath();
          ctx.arc(px, py, 1.5, 0, Math.PI * 2);
          ctx.fill();
        }

        videoAnimId = requestAnimationFrame(loop);
      }
      loop();
    }

    function toggleVideoPlayback() {
      const btn = document.getElementById('btnPlayPauseVid');
      if (videoAnimId) {
        cancelAnimationFrame(videoAnimId);
        videoAnimId = null;
