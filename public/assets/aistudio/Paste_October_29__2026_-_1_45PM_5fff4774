    // Tab 5: Text to Movie Storyboards Logic
    async function buildMovieStoryboard() {
      const script = document.getElementById('storyScriptInput').value.trim();
      if (!script) {
        showToast("يرجى كتابة القصة أو نص الفيلم أولاً.", "warning");
        return;
      }

      document.getElementById('storyboardEmpty').classList.add('hidden');
      document.getElementById('storyboardGrid').innerHTML = "";
      document.getElementById('storyboardProgress').classList.remove('hidden');

      try {
        const apiKey = "";
        const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;

        const payload = {
          contents: [{ parts: [{ text: script }] }],
          generationConfig: {
            responseMimeType: "application/json",
            responseSchema: {
              type: "ARRAY",
              items: {
                type: "OBJECT",
                properties: {
                  "sceneNumber": { "type": "INTEGER" },
                  "title": { "type": "STRING" },
                  "cameraShot": { "type": "STRING" },
                  "description": { "type": "STRING" },
                  "voiceover": { "type": "STRING" },
                  "imagePrompt": { "type": "STRING" }
                },
                "propertyOrdering": ["sceneNumber", "title", "cameraShot", "description", "voiceover", "imagePrompt"]
              }
            }
          },
          systemInstruction: { parts: [{ text: "قم بتقسيم النص المدخل إلى 3 مشاهد سينمائية باللغة العربية بالكامل مع أفكار صوَرية للقطات." }] }
        };

        const res = await fetch(apiUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const data = await res.json();
        const scenes = JSON.parse(data.candidates[0].content.parts[0].text);

        const grid = document.getElementById('storyboardGrid');

        for (const sc of scenes) {
          const card = document.createElement('div');
          card.className = "glass-card rounded-2xl p-5 border border-gray-800 space-y-3 flex flex-col justify-between";
          card.innerHTML = `
            <div class="space-y-2">
              <div class="flex items-center justify-between text-xs">
                <span class="px-2.5 py-1 bg-emerald-500/20 text-emerald-400 font-bold rounded-md">المشهد ${sc.sceneNumber}</span>
                <span class="text-gray-400 font-semibold">${sc.cameraShot}</span>
              </div>
              <h4 class="font-bold text-sm text-white">${sc.title}</h4>
              <div id="sc-img-${sc.sceneNumber}" class="h-44 bg-dark-bg rounded-xl border border-gray-800 flex items-center justify-center relative overflow-hidden">
                <div class="w-8 h-8 rounded-full border-2 border-emerald-500/20 border-t-emerald-500 animate-spin"></div>
              </div>
              <p class="text-xs text-gray-300 leading-relaxed">${sc.description}</p>
              <div class="p-2.5 rounded-xl bg-gray-900/80 border border-gray-800 text-[11px] text-emerald-300">
                <i class="fa-solid fa-microphone ml-1"></i> <strong>التعليق الصوتي:</strong> ${sc.voiceover}
              </div>
            </div>
          `;
          grid.appendChild(card);

          // Fetch Scene Image via Flash Image Model
          (async () => {
            try {
              const imgUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3.1-flash-image:generateContent?key=${apiKey}`;
              const imgRes = await fetch(imgUrl, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  contents: [{ role: 'user', parts: [{ text: `${sc.imagePrompt}, cinematic movie frame` }] }],
                  generationConfig: { responseModalities: ['IMAGE'], imageConfig: { aspectRatio: '16:9' } }
                })
              });
              const imgData = await imgRes.json();
              const b64 = imgData?.candidates?.[0]?.content?.parts?.find(p => p.inlineData)?.inlineData?.data;
              const box = document.getElementById(`sc-img-${sc.sceneNumber}`);
              if (b64) {
                box.innerHTML = `<img src="data:image/png;base64,${b64}" class="w-full h-full object-cover">`;
              } else {
                box.innerHTML = `<img src="https://placehold.co/600x350/0f172a/ffffff?text=Scene+${sc.sceneNumber}" class="w-full h-full object-cover">`;
              }
            } catch (e) {
              document.getElementById(`sc-img-${sc.sceneNumber}`).innerHTML = `<img src="https://placehold.co/600x350/0f172a/ffffff?text=Scene+${sc.sceneNumber}" class="w-full h-full object-cover">`;
            }
          })();
        }

        showToast("تم إنشاء مشاهد الفيلم والسيناريو بنجاح!", "success");
      } catch (err) {
        showToast("حدث خطأ أثناء توليد القصة.", "error");
      } finally {
        document.getElementById('storyboardProgress').classList.add('hidden');
      }
    }

