    // Toast Utility
    function showToast(msg, type = "info") {
      const box = document.getElementById('toastBox');
      const toast = document.createElement('div');

      let bg = "bg-gray-800 border-gray-700 text-white";
      if (type === "success") bg = "bg-emerald-950/90 border-emerald-800 text-emerald-300";
      if (type === "error") bg = "bg-rose-950/90 border-rose-800 text-rose-300";
      if (type === "warning") bg = "bg-amber-950/90 border-amber-800 text-amber-300";

      toast.className = `px-4 py-3 rounded-xl border ${bg} text-xs font-bold shadow-2xl backdrop-blur-md transition-all duration-300 transform translate-y-2 opacity-0 flex items-center space-x-2 space-x-reverse pointer-events-auto`;
      toast.innerHTML = `<span>${msg}</span>`;

      box.appendChild(toast);

      setTimeout(() => toast.classList.remove('translate-y-2', 'opacity-0'), 50);
      setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-y-2');
        setTimeout(() => toast.remove(), 300);
      }, 3500);
    }
