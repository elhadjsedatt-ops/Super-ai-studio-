<!DOCTYPE html>
<html lang="ar" dir="rtl" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SuperAI Studio - منصة توليد المحتوى بالذكاء الاصطناعي الفائقة</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#f0f7ff',
              100: '#e0effe',
              500: '#3b82f6',
              600: '#2563eb',
              700: '#1d4ed8',
              800: '#1e40af',
              900: '#1e3a8a',
            },
            accent: {
              purple: '#8b5cf6',
              pink: '#ec4899',
              gold: '#f59e0b',
              emerald: '#10b981'
            },
            dark: {
              bg: '#0b0f19',
              card: '#131b2e',
              border: '#1f2d4d',
              hover: '#1c2842'
            }
          },
          fontFamily: {
            sans: ['Segoe UI', 'Tahoma', 'Geneva', 'Verdana', 'sans-serif']
          }
        }
      }
    }
  </script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    body {
      background-color: #0b0f19;
      color: #f3f4f6;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }
    
    .glass-card {
      background: rgba(19, 27, 46, 0.75);
      backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .glass-nav {
      background: rgba(11, 15, 25, 0.85);
      backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #0b0f19;
    }
    ::-webkit-scrollbar-thumb {
      background: #2563eb;
      border-radius: 4px;
    }

    .gradient-text {
      background: linear-gradient(135deg, #60a5fa 0%, #a855f7 50%, #ec4899 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .glow-button {
      position: relative;
      transition: all 0.3s ease;
    }
    .glow-button::after {
      content: '';
      position: absolute;
      inset: -2px;
      background: linear-gradient(45deg, #3b82f6, #8b5cf6, #ec4899);
      border-radius: inherit;
      z-index: -1;
      opacity: 0;
      filter: blur(10px);
      transition: opacity 0.3s ease;
    }
    .glow-button:hover::after {
      opacity: 0.8;
    }

    .animate-pulse-subtle {
      animation: pulseSubtle 3s infinite ease-in-out;
    }
    @keyframes pulseSubtle {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.85; }
    }
  </style>
</head>
<body class="h-screen flex flex-col overflow-hidden text-sm">

  <!-- ================= HEADER NAVBAR ================= -->
  <header class="h-16 glass-nav px-6 flex items-center justify-between z-40 shrink-0">
    <!-- Brand Logo and Dynamic Title -->
    <div class="flex items-center space-x-3 space-x-reverse">
      <div id="brandLogoContainer" class="w-10 h-10 rounded-xl bg-gradient-to-tr from-blue-600 via-purple-600 to-pink-500 flex items-center justify-center shadow-lg shadow-purple-500/20 cursor-pointer" onclick="openLogoModal()">
        <span id="appLogoIcon" class="text-white text-lg font-bold"><i class="fa-solid fa-wand-magic-sparkles"></i></span>
      </div>
      <div>
        <h1 class="font-bold text-base leading-tight tracking-wide flex items-center gap-2">
          <span id="appBrandTitle" class="gradient-text font-black text-lg">SuperAI Studio</span>
          <span class="text-[10px] px-2 py-0.5 rounded-full bg-blue-500/20 text-blue-400 font-semibold border border-blue-500/30">PRO v4.2</span>
        </h1>
        <p class="text-[11px] text-gray-400 flex items-center gap-1">
          المحرك النشط: <span id="currentEngineBadge" class="text-purple-400 font-semibold underline cursor-pointer" onclick="openEngineModal()">Gemini Ultra Pro v3</span>
        </p>
      </div>
    </div>

    <!-- Navigation Menu Tabs -->
    <nav class="hidden lg:flex items-center bg-gray-900/90 p-1.5 rounded-xl border border-gray-800 space-x-1 space-x-reverse">
      <button onclick="switchTab('templates')" id="tab-templates" class="nav-tab px-3.5 py-1.5 rounded-lg text-xs font-semibold flex items-center space-x-2 space-x-reverse transition text-white bg-blue-600 shadow">
        <i class="fa-solid fa-cubes text-amber-300"></i>
        <span>القوالب الجاهزة</span>
      </button>
      <button onclick="switchTab('text-to-image')" id="tab-text-to-image" class="nav-tab px-3.5 py-1.5 rounded-lg text-xs font-semibold flex items-center space-x-2 space-x-reverse transition text-gray-400 hover:text-white">
        <i class="fa-solid fa-image text-blue-400"></i>
        <span>توليد الصور</span>
      </button>
      <button onclick="switchTab('text-to-video')" id="tab-text-to-video" class="nav-tab px-3.5 py-1.5 rounded-lg text-xs font-semibold flex items-center space-x-2 space-x-reverse transition text-gray-400 hover:text-white">
        <i class="fa-solid fa-video text-purple-400"></i>
        <span>توليد الفيديو</span>
      </button>
      <button onclick="switchTab('img-to-video')" id="tab-img-to-video" class="nav-tab px-3.5 py-1.5 rounded-lg text-xs font-semibold flex items-center space-x-2 space-x-reverse transition text-gray-400 hover:text-white">
        <i class="fa-solid fa-photo-film text-pink-400"></i>
        <span>تحريك الصور</span>
      </button>
      <button onclick="switchTab('story-movie')" id="tab-story-movie" class="nav-tab px-3.5 py-1.5 rounded-lg text-xs font-semibold flex items-center space-x-2 space-x-reverse transition text-gray-400 hover:text-white">
        <i class="fa-solid fa-clapperboard text-emerald-400"></i>
        <span>صانع الأفلام والقصص</span>
      </button>
    </nav>

    <!-- User & Customization Controls -->
    <div class="flex items-center space-x-3 space-x-reverse">
      <button onclick="openEngineModal()" class="hidden md:flex items-center space-x-2 space-x-reverse px-3 py-1.5 rounded-xl bg-gray-800/80 hover:bg-gray-700 border border-gray-700 text-xs transition">
        <i class="fa-solid fa-microchip text-purple-400"></i>
        <span>تغيير المولد</span>
      </button>
      
      <button onclick="openLogoModal()" class="hidden md:flex items-center space-x-2 space-x-reverse px-3 py-1.5 rounded-xl bg-gray-800/80 hover:bg-gray-700 border border-gray-700 text-xs transition">
        <i class="fa-solid fa-pen-nib text-pink-400"></i>
        <span>تصميم الشعار</span>
      </button>

      <!-- User Auth State Button -->
      <div id="userAuthSection">
        <button onclick="openAuthModal()" id="loginBtn" class="glow-button px-4 py-2 rounded-xl bg-gradient-to-r from-blue-600 to-purple-600 text-white font-bold text-xs flex items-center space-x-2 space-x-reverse shadow-lg">
          <i class="fa-solid fa-user"></i>
          <span id="userNameBadge">تسجيل الدخول</span>
        </button>
      </div>
    </div>
  </header>

  <!-- Mobile Tab Bar -->
  <div class="lg:hidden flex overflow-x-auto border-b border-gray-800 bg-gray-900/90 p-2 space-x-2 space-x-reverse shrink-0">
    <button onclick="switchTab('templates')" class="mobile-tab px-3 py-1.5 rounded-lg text-xs flex-shrink-0 bg-blue-600 text-white font-bold">القوالب</button>
    <button onclick="switchTab('text-to-image')" class="mobile-tab px-3 py-1.5 rounded-lg text-xs flex-shrink-0 bg-gray-800 text-gray-300">الصور</button>
    <button onclick="switchTab('text-to-video')" class="mobile-tab px-3 py-1.5 rounded-lg text-xs flex-shrink-0 bg-gray-800 text-gray-300">الفيديو</button>
    <button onclick="switchTab('img-to-video')" class="mobile-tab px-3 py-1.5 rounded-lg text-xs flex-shrink-0 bg-gray-800 text-gray-300">تحريك الصور</button>
    <button onclick="switchTab('story-movie')" class="mobile-tab px-3 py-1.5 rounded-lg text-xs flex-shrink-0 bg-gray-800 text-gray-300">الأفلام والقصص</button>
  </div>

  <!-- ================= MAIN SUITE CONTENT ================= -->
  <main class="flex-1 flex overflow-hidden relative">

    <!-- TAB 1: SMART TEMPLATES (قوالب جاهزة متفوقة على Leonardo & CapCut) -->
    <div id="view-templates" class="view-panel flex-1 flex flex-col p-6 overflow-y-auto space-y-6">
      <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 border-b border-gray-800 pb-5">
        <div>
          <h2 class="text-xl font-bold text-white flex items-center gap-2">
            <i class="fa-solid fa-wand-magic-sparkles text-amber-400"></i>
            مكتبة القوالب الذكية الاحترافية
          </h2>
          <p class="text-xs text-gray-400 mt-1">اختر من القوالب المجهزة مسبقاً للشبكات الاجتماعية، الإعلانات، والأفلام السينمائية بنقرة واحدة.</p>
        </div>
        
        <div class="flex items-center space-x-2 space-x-reverse bg-gray-900 p-1 rounded-xl border border-gray-800">
          <button onclick="filterTemplates('all')" class="tpl-filter px-3 py-1.5 rounded-lg text-xs font-semibold bg-blue-600 text-white">الكل</button>
          <button onclick="filterTemplates('image')" class="tpl-filter px-3 py-1.5 rounded-lg text-xs font-semibold text-gray-400 hover:text-white">قوالب الصور (InstaSize)</button>
          <button onclick="filterTemplates('video')" class="tpl-filter px-3 py-1.5 rounded-lg text-xs font-semibold text-gray-400 hover:text-white">قوالب الفيديو (CapCut)</button>
          <button onclick="filterTemplates('movie')" class="tpl-filter px-3 py-1.5 rounded-lg text-xs font-semibold text-gray-400 hover:text-white">قوالب القصص والأفلام</button>
        </div>
      </div>

      <!-- Templates Grid -->
      <div id="templatesContainer" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
        <!-- Templates auto injected via JS -->
      </div>
    </div>

    <!-- TAB 2: TEXT TO IMAGE GENERATOR -->
    <div id="view-text-to-image" class="view-panel hidden flex-1 flex flex-col lg:flex-row overflow-hidden w-full">
      <!-- Config Panel Left -->
      <div class="w-full lg:w-80 border-l border-gray-800 bg-dark-bg p-5 overflow-y-auto shrink-0 space-y-5">
        <div>
          <h3 class="text-sm font-bold uppercase tracking-wider text-gray-300 mb-1 flex items-center justify-between">
            <span>إعدادات توليد الصور</span>
            <span class="text-[10px] bg-blue-500/20 text-blue-400 px-2 py-0.5 rounded border border-blue-500/30">InstaSize AI</span>
          </h3>
          <p class="text-xs text-gray-500">خصص نمط الأبعاد والدقة ومحرك الرسم</p>
        </div>

        <div class="space-y-4">
          <div>
            <label class="block text-xs font-semibold text-gray-300 mb-1.5">أبعاد الصورة (Aspect Ratio)</label>
            <div class="grid grid-cols-2 gap-2" id="imgAspectGrid">
              <button onclick="selectAspect('1:1')" class="aspect-card active p-2.5 rounded-xl border border-blue-500 bg-blue-500/10 text-xs text-center flex flex-col items-center gap-1">
                <i class="fa-solid fa-square text-base"></i>
                <span>1:1 مربع (إنستغرام)</span>
              </button>
              <button onclick="selectAspect('9:16')" class="aspect-card p-2.5 rounded-xl border border-gray-800 bg-dark-card text-xs text-center flex flex-col items-center gap-1 hover:border-gray-700">
                <i class="fa-solid fa-mobile-button text-base"></i>
                <span>9:16 ستوري / تيك توك</span>
              </button>
              <button onclick="selectAspect('16:9')" class="aspect-card p-2.5 rounded-xl border border-gray-800 bg-dark-card text-xs text-center flex flex-col items-center gap-1 hover:border-gray-700">
                <i class="fa-solid fa-display text-base"></i>
                <span>16:9 سينمائي / يوتيوب</span>
              </button>
              <button onclick="selectAspect('4:5')" class="aspect-card p-2.5 rounded-xl border border-gray-800 bg-dark-card text-xs text-center flex flex-col items-center gap-1 hover:border-gray-700">
                <i class="fa-solid fa-image text-base"></i>
                <span>4:5 بورتريت متقدم</span>
              </button>
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold text-gray-300 mb-1.5">النمط الفني (Art Style)</label>
            <select id="imageStyleSelect" class="w-full bg-dark-card border border-gray-700 rounded-xl p-2.5 text-xs text-white focus:outline-none focus:border-blue-500">
              <option value="photorealistic">واقعي سينمائي (Photorealistic Ultra 8K)</option>
              <option value="cyberpunk">سايبربانك ونيون مستقبلي (Cyberpunk Neon)</option>
              <option value="anime">أنمي ياباني احترافي (Modern Anime Art)</option>
              <option value="3d-render">رندر ثلاثي الأبعاد (3D Octane Render)</option>
              <option value="fantasy">خيالي ورسم زيتي (High Fantasy Oil Art)</option>
              <option value="logo-icon">شعار وأيقونة متجهية (Vector Logo/Icon)</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-semibold text-gray-300 mb-1.5">محرر الصور المدمج (InstaSize Tool)</label>
            <div class="space-y-2">
              <label class="flex items-center space-x-2 space-x-reverse text-xs text-gray-300 cursor-pointer">
                <input type="checkbox" id="chkAutoRemoveBg" class="rounded bg-dark-card border-gray-700 text-blue-600 focus:ring-0">
                <span>تفريغ وإزالة الخلفية تلقائياً (Remove BG)</span>
              </label>
              <label class="flex items-center space-x-2 space-x-reverse text-xs text-gray-300 cursor-pointer">
                <input type="checkbox" id="chkUpscale4k" checked class="rounded bg-dark-card border-gray-700 text-blue-600 focus:ring-0">
                <span>تحسين الدقة إلى 4K تلقائياً (AI Upscale)</span>
              </label>
            </div>
          </div>
        </div>
      </div>

      <!-- Main Canvas Center -->
      <div class="flex-1 flex flex-col p-6 overflow-y-auto space-y-6">
        <div class="flex-1 min-h-[350px] glass-card rounded-2xl flex flex-col items-center justify-center relative overflow-hidden p-4 border border-gray-800">
          <div id="imgPlaceholder" class="text-center space-y-3 p-6 max-w-md">
            <div class="w-16 h-16 rounded-2xl bg-blue-500/10 text-blue-400 flex items-center justify-center mx-auto text-2xl border border-blue-500/20">
              <i class="fa-solid fa-palette"></i>
            </div>
            <h3 class="text-base font-bold text-gray-200">مولد الصور الفائق بالذكاء الاصطناعي</h3>
            <p class="text-xs text-gray-400 leading-relaxed">أدخل وصفاً تفصيلياً باللغة العربية أو الإنجليزية. المحرك يدعم كتابة النصوص داخل الصور بدقة عالية وتوليد تفاصيل دقيقة للغاية.</p>
          </div>

          <!-- Processing State -->
          <div id="imgLoading" class="hidden absolute inset-0 bg-dark-bg/90 backdrop-blur-md flex flex-col items-center justify-center space-y-4 z-20">
            <div class="w-16 h-16 rounded-full border-4 border-blue-500/20 border-t-blue-500 animate-spin"></div>
            <p id="imgLoadingText" class="text-xs text-blue-400 font-bold tracking-wide">جاري رسم وتوليد الصورة عبر المحرك...</p>
          </div>

          <!-- Image Output Box -->
          <div id="imgResultBox" class="hidden w-full h-full flex flex-col items-center justify-center relative group">
            <img id="imgResultDisplay" class="max-h-[500px] max-w-full rounded-xl object-contain shadow-2xl border border-gray-800" src="" alt="النتيجة المفلترة">
            <div class="absolute bottom-4 left-1/2 -translate-x-1/2 opacity-0 group-hover:opacity-100 transition-opacity bg-dark-bg/90 backdrop-blur-md p-2 rounded-xl border border-gray-700 flex items-center space-x-2 space-x-reverse">
              <button onclick="downloadImageResult()" class="px-3.5 py-2 bg-blue-600 hover:bg-blue-500 text-white rounded-lg text-xs font-bold flex items-center space-x-1.5 space-x-reverse">
                <i class="fa-solid fa-download"></i>
                <span>تحميل الصورة</span>
              </button>
              <button onclick="sendToAnimateTab()" class="px-3.5 py-2 bg-purple-600 hover:bg-purple-500 text-white rounded-lg text-xs font-bold flex items-center space-x-1.5 space-x-reverse">
                <i class="fa-solid fa-film"></i>
                <span>تحويل إلى فيديو</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Input Bar -->
        <div class="glass-panel p-4 rounded-2xl border border-gray-800 space-y-3">
          <div class="flex items-center justify-between">
            <label class="text-xs font-bold text-gray-300 flex items-center space-x-2 space-x-reverse">
              <i class="fa-solid fa-pen-nib text-blue-400"></i>
              <span>الوصف النصي للصورة (Prompt)</span>
            </label>
            <button onclick="magicEnhanceImgPrompt()" class="text-xs text-purple-400 hover:text-purple-300 font-bold flex items-center space-x-1 space-x-reverse">
              <i class="fa-solid fa-wand-magic-sparkles"></i>
              <span>تحسين الذكاء الاصطناعي</span>
            </button>
          </div>
          <div class="relative">
            <textarea id="imgPromptInput" rows="3" class="w-full bg-dark-bg/80 border border-gray-700 rounded-xl p-3 text-xs text-white placeholder-gray-500 focus:outline-none focus:border-blue-500 resize-none pl-32" placeholder="مثال: رائد فضاء يستكشف مدينة مستقبلية مليئة بأنوار النيون، تصوير سينمائي، دقة 8K فائقة..."></textarea>
            <button onclick="generateImage()" class="glow-button absolute bottom-3 left-3 px-6 py-2.5 bg-gradient-to-r from-blue-600 to-purple-600 text-white rounded-xl text-xs font-bold shadow-lg flex items-center space-x-2 space-x-reverse">
              <i class="fa-solid fa-sparkles"></i>
              <span>توليد الصورة</span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- TAB 3: TEXT TO VIDEO GENERATOR (CapCut Engine) -->
    <div id="view-text-to-video" class="view-panel hidden flex-1 flex flex-col lg:flex-row overflow-hidden w-full">
      <!-- Config Left -->
      <div class="w-full lg:w-80 border-l border-gray-800 bg-dark-bg p-5 overflow-y-auto shrink-0 space-y-5">
        <div>
          <h3 class="text-sm font-bold uppercase tracking-wider text-gray-300 mb-1 flex items-center justify-between">
            <span>إعدادات الفيديو والتأثيرات</span>
            <span class="text-[10px] bg-purple-500/20 text-purple-400 px-2 py-0.5 rounded border border-purple-500/30">CapCut AI</span>
          </h3>
          <p class="text-xs text-gray-500">تحكم بفيزيائية الحركة والكاميرا السينمائية</p>
        </div>

        <div class="space-y-4">
          <div>
            <label class="block text-xs font-semibold text-gray-300 mb-1.5">حركة الكاميرا (Camera Motion)</label>
            <select id="videoCameraMotion" class="w-full bg-dark-card border border-gray-700 rounded-xl p-2.5 text-xs text-white focus:outline-none focus:border-purple-500">
              <option value="cinematic">حركة زوم سينمائي هادئ (Cinematic Slow Zoom)</option>
              <option value="drone">مسح جوي بالطائرة المسيرة (Aerial Drone Sweep)</option>
              <option value="orbit">دوران 360 درجة حول الهدف (360 Orbit)</option>
              <option value="hyperlapse">حركة متسارعة (Hyperlapse Motion)</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-semibold text-gray-300 mb-1.5">شدة الحركة (Motion Intensity)</label>
            <input type="range" id="videoMotionSlider" min="1" max="10" value="6" class="w-full accent-purple-500">
            <div class="flex justify-between text-[10px] text-gray-500 mt-1">
              <span>بطيئة هادئة</span>
              <span>متوازنة</span>
              <span>ديناميكية عالية</span>
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold text-gray-300 mb-1.5">مدة المقطع المطلوب</label>
            <div class="grid grid-cols-3 gap-2">
              <button onclick="setVidDuration('5s')" class="vid-dur-card active p-2 rounded-xl border border-purple-500 bg-purple-500/10 text-xs text-center font-bold">5 ثوانٍ</button>
              <button onclick="setVidDuration('10s')" class="vid-dur-card p-2 rounded-xl border border-gray-800 bg-dark-card text-xs text-center font-bold hover:border-gray-700">10 ثوانٍ</button>
              <button onclick="setVidDuration('15s')" class="vid-dur-card p-2 rounded-xl border border-gray-800 bg-dark-card text-xs text-center font-bold hover:border-gray-700">15 ثانية</button>
            </div>
          </div>
        </div>
      </div>

      <!-- Main Canvas Center -->
      <div class="flex-1 flex flex-col p-6 overflow-y-auto space-y-6">
        <div class="flex-1 min-h-[350px] glass-card rounded-2xl flex flex-col items-center justify-center relative overflow-hidden p-4 border border-gray-800">
          <div id="vidPlaceholder" class="text-center space-y-3 p-6 max-w-md">
            <div class="w-16 h-16 rounded-2xl bg-purple-500/10 text-purple-400 flex items-center justify-center mx-auto text-2xl border border-purple-500/20">
              <i class="fa-solid fa-clapperboard"></i>
            </div>
            <h3 class="text-base font-bold text-gray-200">مولد الفيديوهات السينمائية</h3>
            <p class="text-xs text-gray-400 leading-relaxed">حول أفكارك النصية إلى مقاطع فيديو متكافئة بفيزيائية إضاءة وحركة الواقع مع إمكانية تحريك العناصر بدقة.</p>
          </div>

          <!-- Video Processing State -->
          <div id="vidLoading" class="hidden absolute inset-0 bg-dark-bg/90 backdrop-blur-md flex flex-col items-center justify-center space-y-4 z-20">
            <div class="w-16 h-16 rounded-full border-4 border-purple-500/20 border-t-purple-500 animate-spin"></div>
