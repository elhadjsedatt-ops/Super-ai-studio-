    async function generateImage() {
      const prompt = document.getElementById('imgPromptInput').value.trim();
      if (!prompt) {
        showToast("يرجى إدخال وصف للصورة أولاً.", "warning");
        return;
      }

      document.getElementById('imgPlaceholder').classList.add('hidden');
      document.getElementById('imgResultBox').classList.add('hidden');
      document.getElementById('imgLoading').classList.remove('hidden');

      try {
        const apiKey = ""; // Canvas provides API key at runtime
        const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3.1-flash-image:generateContent?key=${apiKey}`;

        const payload = {
          contents: [{ role: 'user', parts: [{ text: `High detailed artistic image: ${prompt}` }] }],
          generationConfig: {
            responseModalities: ['IMAGE'],
            imageConfig: { aspectRatio: currentAspect }
          }
        };

        const res = await fetch(apiUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const data = await res.json();
        const base64 = data?.candidates?.[0]?.content?.parts?.find(p => p.inlineData)?.inlineData?.data;

        if (base64) {
          currentGeneratedImgUrl = `data:image/png;base64,${base64}`;
          document.getElementById('imgResultDisplay').src = currentGeneratedImgUrl;
          document.getElementById('imgResultBox').classList.remove('hidden');
